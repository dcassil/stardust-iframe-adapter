{
  "name": "@stardust-cms/iframe-adapter",
  "version": "0.0.0",
  "description": "Typed, framework-agnostic protocol plus iframe/host adapters for building in-iframe visual editors, transported over frame-link.",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Cassil",
  "sideEffects": false,
  "keywords": [
    "iframe",
    "postMessage",
    "frame-link",
    "cms",
    "visual-editor",
    "overlay",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/iframe.d.ts",
      "import": "./dist/iframe.js"
    },
    "./iframe": {
      "types": "./dist/iframe.d.ts",
      "import": "./dist/iframe.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "frame-link": "^3.0.0",
    "frame-link-react": "^3.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "frame-link": "file:../../../frame-link",
    "frame-link-react": "file:../../../frame-link-react",
    "jsdom": "^25.0.1",
    "react-dom": "^19.2.8",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
