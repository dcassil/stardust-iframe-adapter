{
  "name": "@stardust-cms/iframe-adapter",
  "version": "0.1.7",
  "description": "Typed, framework-agnostic protocol plus iframe/host adapters for building in-iframe visual editors, transported over frame-link.",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Cassil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcassil/stardust-iframe-adapter.git"
  },
  "homepage": "https://github.com/dcassil/stardust-iframe-adapter#readme",
  "bugs": {
    "url": "https://github.com/dcassil/stardust-iframe-adapter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "iframe",
    "postMessage",
    "frame-link",
    "cms",
    "visual-editor",
    "overlay",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/iframe.d.ts",
      "import": "./dist/iframe.js"
    },
    "./iframe": {
      "types": "./dist/iframe.d.ts",
      "import": "./dist/iframe.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./presence": {
      "types": "./dist/presence.d.ts",
      "import": "./dist/presence.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:install": "npm --prefix demo install",
    "demo": "npm --prefix demo run demo",
    "demo:site": "npm --prefix demo run demo:site",
    "demo:admin": "npm --prefix demo run demo:admin",
    "demo:test": "npm --prefix demo run test",
    "demo:typecheck": "npm --prefix demo run typecheck",
    "demo:build": "npm --prefix demo run build",
    "demo:e2e": "npm --prefix demo run e2e",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "demo:lint": "npm --prefix demo run lint",
    "demo:depcruise": "npm --prefix demo run depcruise"
  },
  "dependencies": {
    "colab-ui": "^0.1.2"
  },
  "peerDependencies": {
    "frame-link": "^4.0.0",
    "frame-link-react": "^4.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "frame-link": "^4.0.0",
    "frame-link-react": "^4.0.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.0"
  }
}
